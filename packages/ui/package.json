{
  "name": "@sapling2d/ui",
  "version": "0.1.0",
  "description": "UI controls for sapling2d: Control (size + anchors), Button (press feedback, disabled state, click sound) and ProgressBar, with a neutral default skin installed as a plugin.",
  "keywords": [
    "sapling2d",
    "game-engine",
    "ui",
    "button",
    "progress-bar",
    "wechat-minigame"
  ],
  "license": "MIT",
  "author": "kwoktung",
  "homepage": "https://sapling2d.github.io/sapling2d/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapling2d/sapling2d.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/sapling2d/sapling2d/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "sapling2d": {
    "assets": "assets"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "assets": "node scripts/gen-assets.mjs",
    "build": "tsdown",
    "prepublishOnly": "node ../engine/scripts/check-publish.ts && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "sapling2d": ">=0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "sapling2d": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
