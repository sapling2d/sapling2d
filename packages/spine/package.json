{
  "name": "@sapling2d/spine",
  "version": "0.1.0",
  "description": "Spine skeletal animation for sapling2d: SpineSprite node, spineSkeleton() resource and a spine() plugin, built on @esotericsoftware/spine-core 4.3. Browser, WeChat Mini Game and headless tests.",
  "keywords": [
    "sapling2d",
    "game-engine",
    "spine",
    "skeletal-animation",
    "spine-runtime",
    "pixi",
    "wechat-minigame"
  ],
  "license": "MIT",
  "author": "kwoktung",
  "homepage": "https://sapling2d.github.io/sapling2d/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwoktung/sapling2d.git",
    "directory": "packages/spine"
  },
  "bugs": {
    "url": "https://github.com/kwoktung/sapling2d/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sapling2d": {
    "assetFunctions": [
      "spineSkeleton"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "prepublishOnly": "node ../engine/scripts/check-publish.ts && pnpm build && pnpm test"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "^4.3.13"
  },
  "peerDependencies": {
    "pixi.js": "^8.16.0",
    "sapling2d": ">=0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pixi.js": "~8.22.0",
    "sapling2d": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
